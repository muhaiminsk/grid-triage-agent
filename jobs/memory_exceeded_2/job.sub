universe = vanilla
executable = run.sh
periodic_hold = (MemoryUsage =!= undefined) && (MemoryUsage > RequestMemory)
periodic_hold_reason = "Job memory usage exceeded request_memory"
log = job.log
output = stdout.txt
error = stderr.txt
request_cpus = 1
request_memory = 96
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
queue
